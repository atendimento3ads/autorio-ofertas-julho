Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Uma única URL canônica: HTTPS, sem www e sem /index.html.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\x20]) [NC]
  RewriteRule ^(.*/)?index\.html$ https://autorioconcessionaria.com.br/$1 [R=301,L,NE]

  # A instalação entregue é estática. Rotas e executáveis antigos do WordPress não existem.
  RewriteRule ^(?:wp-admin|wp-content|wp-includes|wp-json)(?:/|$) - [G,L,NC]
  RewriteRule ^(?:wp-login\.php|xmlrpc\.php|wp-config\.php|readme\.html|license\.txt)$ - [G,L,NC]
  RewriteRule \.php$ - [G,L,NC]

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^autorioconcessionaria\.com\.br$ [NC]
  RewriteRule ^ https://autorioconcessionaria.com.br%{REQUEST_URI} [R=301,L,NE]

  # Compatibilidade com links antigos das páginas de confirmação.
  RewriteRule ^obrigado/?$ /obrigado.html [R=301,L]
  RewriteRule ^move-brasil/obrigado/?$ /move-brasil/obrigado.html [R=301,L]

</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-goOAZ52++NVlkEfaV6NpqTpghKIwrqUgZgG4M6JVrEM=' 'sha256-SsM96QCRF53hTyadbzN+jHaH47FaO9vhNA2GV6wpZH4=' 'sha256-tiQgFFh3GC82URoxDK//PK1siFhY5HfZk4MKXNqv9bY=' 'sha256-dFGaksBGL4MAj0+RXdovWyftgEFXBxjSLywMZJH8oxc=' https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com; script-src-elem 'self' 'sha256-goOAZ52++NVlkEfaV6NpqTpghKIwrqUgZgG4M6JVrEM=' 'sha256-SsM96QCRF53hTyadbzN+jHaH47FaO9vhNA2GV6wpZH4=' 'sha256-tiQgFFh3GC82URoxDK//PK1siFhY5HfZk4MKXNqv9bY=' 'sha256-dFGaksBGL4MAj0+RXdovWyftgEFXBxjSLywMZJH8oxc=' https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com; style-src 'self' 'sha256-sNeulMahlQlvmHFcI+y7QmhO3pgVHN4VXdNMVVF2PIM=' 'sha256-SOt84tIPh5vFf/7wpDuMXk8orOYo/jP6ExFQYZJUBS8=' 'sha256-LrVchzrqfIZ2ntapIAesjNbm/8EpVEoNsjkhL/E2pBE=' https://fonts.googleapis.com; style-src-elem 'self' 'sha256-sNeulMahlQlvmHFcI+y7QmhO3pgVHN4VXdNMVVF2PIM=' 'sha256-SOt84tIPh5vFf/7wpDuMXk8orOYo/jP6ExFQYZJUBS8=' 'sha256-LrVchzrqfIZ2ntapIAesjNbm/8EpVEoNsjkhL/E2pBE=' https://fonts.googleapis.com; img-src 'self' data: blob: https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://www.google.com https://www.google.com.br https://googleads.g.doubleclick.net https://*.g.doubleclick.net https://pagead2.googlesyndication.com https://i.ytimg.com; font-src 'self' https://fonts.gstatic.com https://brands.gm-cdn.com; connect-src 'self' https://hook.us2.make.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://www.googleadservices.com https://www.google.com https://www.google.com.br https://googleads.g.doubleclick.net https://*.g.doubleclick.net https://pagead2.googlesyndication.com; frame-src https://www.youtube-nocookie.com https://www.googletagmanager.com https://googleads.g.doubleclick.net https://*.g.doubleclick.net https://www.google.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

<FilesMatch "\.(?:css|js|woff2|avif|png|jpe?g|webp|svg)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

<FilesMatch "\.(?:sql|sqlite|bak|old|orig|log|ini|env|zip|tar|gz|7z)$">
  Require all denied
</FilesMatch>
